# ──────────────────────────────────────────────
# Micropatient AI Test Suite — Environment Config
# ──────────────────────────────────────────────

# Application Under Test
MICROPATIENT_BASE_URL=http://localhost:8000
MICROPATIENT_UI_URL=http://localhost:3000

# Authentication
TEST_ADMIN_USERNAME=admin@micropatient.dev
TEST_ADMIN_PASSWORD=test-admin-password
TEST_DOCTOR_USERNAME=doctor@micropatient.dev
TEST_DOCTOR_PASSWORD=test-doctor-password
TEST_PATIENT_USERNAME=patient@micropatient.dev
TEST_PATIENT_PASSWORD=test-patient-password

# LLM / OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
EVAL_MODEL=gpt-4o-2024-11-20
EVAL_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=micropatient-evals
LANGCHAIN_TRACING_V2=true

# DeepEval
DEEPEVAL_API_KEY=your-deepeval-key

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
ATHENA_DATABASE=micropatient_prod
ATHENA_S3_OUTPUT=s3://micropatient-athena-results/

# Metric Thresholds (overrides config/thresholds.yaml)
FAITHFULNESS_THRESHOLD=0.8
RELEVANCE_THRESHOLD=0.75
HALLUCINATION_THRESHOLD=0.15
LATENCY_P95_THRESHOLD_MS=2000

# Environment
ENV=staging
